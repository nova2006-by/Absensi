.env
.env.*
!.env.example
node_modules
vendor
bootstrap/cache
storage/logs
database/*.sqlite
database/*.sqlite3
database/*.db
public/hot
public/uploads/*
.phpunit.result.cache
.phpactor.json
auth.json
