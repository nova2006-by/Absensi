APP_NAME="SMK NU Bandar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI-DENGAN-DOMAIN-ANDA
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Gunakan nama host, nama basis data, dan pengguna yang diberikan cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Tabel sesi dan cache tersedia melalui migrasi aplikasi.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Gunakan sync jika hosting tidak menyediakan pekerja antrean yang selalu aktif.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Isi hanya sementara untuk pemasangan pertama; hapus setelah selesai.
INSTALL_KEY=
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Isi koordinat sekolah sebelum menerima absensi siswa.
ABSEN_LOKASI_LATITUDE=
ABSEN_LOKASI_LONGITUDE=
ABSEN_LOKASI_RADIUS=100
ABSEN_JAM_MASUK_MULAI=06:30
ABSEN_JAM_MASUK=07:30
ABSEN_JAM_MASUK_BATAS=08:30
ABSEN_JAM_PULANG_MULAI=14:30
ABSEN_JAM_PULANG_BATAS=17:00

# Konfigurasikan SMTP hanya jika aplikasi akan mengirim email.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
