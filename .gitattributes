# Normalize line endings: shell scripts and Docker files must use LF,
# otherwise Docker build/run on Linux (Vercel, Render) fails with
# "/usr/bin/env: 'bash'\r: No such file or directory" or
# "/bin/sh^M: bad interpreter" errors because Windows checked out CRLF.
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.sh text eol=lf
docker/* text eol=lf
*.conf text eol=lf

* text=auto